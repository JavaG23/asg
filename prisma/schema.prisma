// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

// User model for drivers, admins, donors, and volunteers
model User {
  id                       Int           @id @default(autoincrement())
  bloomerangId             String?       @unique
  name                     String
  email                    String        @unique
  phone                    String?
  passwordHash             String?
  passwordResetToken       String?       @unique
  passwordResetTokenExpiry DateTime?
  role                     String        @default("driver") // DEPRECATED: Use boolean role fields instead
  active                   Boolean       @default(true)
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  // Multi-role support (#43) - Users can have any combination of roles
  isAdmin      Boolean @default(false)
  isDriver     Boolean @default(true)  // Default true for backward compatibility
  isDonor      Boolean @default(false)
  isVolunteer  Boolean @default(false)

  // Home address fields for map display (#29)
  homeStreet    String?
  homeCity      String?
  homeState     String?
  homeZip       String?
  homeLatitude  Float?
  homeLongitude Float?

  // Pending profile changes awaiting admin approval (#30)
  pendingChanges String? // JSON string with proposed changes

  routes       Route[]
  deliveryLogs DeliveryLog[]
  sessions     Session[]
  donor        Donor?        // Link to Donor record if user is a donor (#50)

  // Volunteer portal relations (#36)
  volunteerSignups     VolunteerSignup[] @relation("VolunteerSignups")
  signupApprovals      VolunteerSignup[] @relation("SignupApprovals")
  volunteerHourLogs    VolunteerHourLog[]
  processedOnboardings PendingOnboarding[]

  // Volunteer portal build-out (#65)
  opportunityPreferences UserOpportunityPreference[]

  // 65j
  hourLogVerifications     VolunteerHourLog[]        @relation("HourLogVerifications")
  opportunityRegistrations OpportunityRegistration[]

  @@index([email])
  @@index([bloomerangId])
}

// Route model for daily delivery routes
model Route {
  id          Int       @id @default(autoincrement())
  name        String
  driverId    Int?
  date        DateTime
  status      String    @default("pending") // "pending" | "active" | "pending_weight" | "completed"
  routeType   String    @default("pickup") // "pickup" | "bag_delivery" (#39)
  totalWeight Float?    // Total food weight in pounds (#14)
  startedAt   DateTime? // When driver started the route (#26)
  weighedAt   DateTime? // When food was weighed at distribution center (#26)
  completedAt DateTime? // When all stops were completed (65j) - set for both route types
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  driver    User?     @relation(fields: [driverId], references: [id], onDelete: SetNull)
  addresses Address[]
  hourLogs  VolunteerHourLog[] // auto-logged driver hours (65j)

  @@index([driverId])
  @@index([date])
  @@index([status])
  @@index([routeType])
}

// Donor model for tracking food donors across events (#22)
model Donor {
  id        Int       @id @default(autoincrement())
  userId    Int?      @unique // Link to User account if donor has one (#50)
  name      String
  email     String?   @unique
  phone     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  addresses    Address[]
  eventOptIns  DonorEventOptIn[] // Pickup event opt-ins (#35)

  @@index([email])
  @@index([userId])
}

// Address model for pickup/delivery locations
model Address {
  id                  Int           @id @default(autoincrement())
  routeId             Int
  donorId             Int?          // Link to donor for tracking (#22)
  sequenceOrder       Int
  streetAddress       String
  city                String
  state               String
  zipCode             String
  latitude            Float?
  longitude           Float?
  specialInstructions String?
  status              String        @default("pending") // "pending" | "completed" | "skipped"
  // Donor contact info for thank-you emails and reports (#60)
  donorName           String?
  donorEmail          String?
  donorPhone          String?

  route        Route         @relation(fields: [routeId], references: [id], onDelete: Cascade)
  donor        Donor?        @relation(fields: [donorId], references: [id], onDelete: SetNull)
  deliveryLogs DeliveryLog[]

  @@index([routeId])
  @@index([donorId])
  @@index([status])
}

// DeliveryLog model for tracking completed deliveries
model DeliveryLog {
  id           Int       @id @default(autoincrement())
  addressId    Int
  driverId     Int
  foodOutside  Boolean?
  notes        String?
  completedAt  DateTime  @default(now())
  gpsLatitude  Float?
  gpsLongitude Float?

  address Address @relation(fields: [addressId], references: [id])
  driver  User    @relation(fields: [driverId], references: [id])

  @@index([addressId])
  @@index([driverId])
  @@index([completedAt])
}

// RouteArchive model for permanent historical records of completed routes
// This ensures route data is preserved even if the route is deleted from the active routes
model RouteArchive {
  id               Int       @id @default(autoincrement())
  routeId          Int       // Original route ID
  routeName        String
  routeDate        DateTime
  driverName       String?
  driverEmail      String?
  driverPhone      String?
  totalStops       Int
  completedStops   Int
  skippedStops     Int
  completionRate   Float
  volunteerHours   Float
  totalWeight      Float?    // Total food weight in pounds
  startedAt        DateTime? // When driver started the route
  weighedAt        DateTime? // When food was weighed at distribution center
  completedAt      DateTime  @default(now()) // When the route was completed/archived
  routeData        String    // JSON snapshot of full route data including addresses and delivery logs

  @@index([routeDate])
  @@index([completedAt])
  @@index([driverEmail])
}

// Session model for persistent database sessions
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ChangeLog model for auditing database modifications
model ChangeLog {
  id          Int      @id @default(autoincrement())
  userId      Int?     // User who made the change (null for system changes)
  userName    String?  // Cached user name for display
  action      String   // "create" | "update" | "delete" | "import"
  entityType  String   // "user" | "route" | "address" | "deliveryLog"
  entityId    Int      // ID of the affected record
  entityName  String?  // Cached name/identifier for display
  field       String?  // Field that was changed (null for create/delete)
  oldValue    String?  // Previous value (JSON string for complex types)
  newValue    String?  // New value (JSON string for complex types)
  metadata    String?  // Additional context as JSON (e.g., import batch info)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}

// ============================================
// FOOD DONATION PORTAL MODELS (#35)
// ============================================

// Pickup events for donor scheduling
model PickupEvent {
  id             Int       @id @default(autoincrement())
  date           DateTime  @unique
  description    String?
  optInDeadline  DateTime?
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  optIns         DonorEventOptIn[]

  @@index([date])
}

// Donor opt-in tracking for pickup events
model DonorEventOptIn {
  id                 Int       @id @default(autoincrement())
  donorId            Int
  eventId            Int
  status             String    @default("opted_in") // opted_in | cancelled | completed
  reminderPreference String    @default("24h")      // 24h | 48h | none
  reminderSentAt     DateTime?
  optedInAt          DateTime  @default(now())
  cancelledAt        DateTime?
  cancelReason       String?

  donor              Donor       @relation(fields: [donorId], references: [id], onDelete: Cascade)
  event              PickupEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([donorId, eventId])
  @@index([donorId])
  @@index([eventId])
}

// ============================================
// VOLUNTEER PORTAL MODELS (#36)
// ============================================

// Volunteer shifts at distribution center
model VolunteerShift {
  id          Int       @id @default(autoincrement())
  date        DateTime
  startTime   String    // "09:00" format
  endTime     String    // "12:00" format
  location    String    @default("Distribution Center")
  spotsNeeded Int
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Volunteer portal build-out (#65) - nullable for backward compatibility
  opportunityTypeId Int?
  templateId        Int? // set when generated from a RecurringShiftTemplate
  // 65j: true when an admin created this shift or edited its spots manually
  // (e.g. "30 drivers needed Saturday" before routes exist). The driver-routes
  // sync never overwrites spotsNeeded on manually-set shifts.
  spotsManuallySet  Boolean @default(false)

  signups     VolunteerSignup[]
  hourLogs    VolunteerHourLog[]
  opportunityType OpportunityType?        @relation(fields: [opportunityTypeId], references: [id], onDelete: SetNull)
  template        RecurringShiftTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([opportunityTypeId])
  @@index([templateId])
}

// Volunteer shift sign-ups
model VolunteerSignup {
  id           Int       @id @default(autoincrement())
  userId       Int
  shiftId      Int
  status       String    @default("pending") // pending | approved | waitlisted | cancelled
  requestedAt  DateTime  @default(now())
  approvedAt   DateTime?
  approvedById Int?
  cancelledAt  DateTime?

  user         User           @relation("VolunteerSignups", fields: [userId], references: [id], onDelete: Cascade)
  shift        VolunteerShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  approvedBy   User?          @relation("SignupApprovals", fields: [approvedById], references: [id])

  @@unique([userId, shiftId])
  @@index([userId])
  @@index([shiftId])
  @@index([status])
}

// Volunteer hour logging with clock in/out
model VolunteerHourLog {
  id           Int       @id @default(autoincrement())
  userId       Int
  shiftId      Int?
  clockIn      DateTime
  clockOut     DateTime?
  totalMinutes Int?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // 65j: attribution + verification
  opportunityTypeId Int?    // which opportunity these hours are for
  routeId           Int?    // set for auto-logged driver-route hours (also dedup key)
  source            String  @default("clock") // clock | manual | route
  verified          Boolean @default(false)   // admin-verified (auto route logs are verified)
  verifiedById      Int?
  verifiedAt        DateTime?

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  shift           VolunteerShift?  @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  opportunityType OpportunityType? @relation(fields: [opportunityTypeId], references: [id], onDelete: SetNull)
  route           Route?           @relation(fields: [routeId], references: [id], onDelete: SetNull)
  verifiedBy      User?            @relation("HourLogVerifications", fields: [verifiedById], references: [id])

  @@index([userId])
  @@index([clockIn])
  @@index([opportunityTypeId])
  @@index([routeId])
  @@index([verified])
}

// ============================================
// ONBOARDING MODELS (#34, #35, #36)
// ============================================

// Pending onboarding applications for donors and volunteers
model PendingOnboarding {
  id              Int       @id @default(autoincrement())
  type            String    // "donor" | "volunteer"
  email           String    @unique
  applicationData String    // JSON with all application details
  status          String    @default("pending") // pending | approved | rejected
  submittedAt     DateTime  @default(now())
  processedAt     DateTime?
  processedById   Int?

  processedBy     User?     @relation(fields: [processedById], references: [id])

  @@index([email])
  @@index([status])
  @@index([type])
}

// ============================================
// VOLUNTEER PORTAL BUILD-OUT MODELS (#65)
// Bloomerang-style opportunity types, recurring
// schedules, and per-user opportunity preferences.
// NOTE: Do NOT migrate until production testing is
// complete (shared prod/dev database). All changes
// are additive (new tables + nullable columns).
// ============================================

// An opportunity category (e.g. "Distribution", "Birthday Bags",
// "Self-reported Service Hours"). Mirrors the Bloomerang opportunity
// cards: description + image + a manager who can be contacted.
model OpportunityType {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  slug         String   @unique
  description  String?  // shown on the detail page (paste from Bloomerang)
  imageUrl     String?  // cover/banner image (store under public/opportunities/)
  iconUrl      String?  // small logo/icon shown on the compact tile (65j)
  managerName  String?
  managerEmail String?  // recipient of "Contact Manager" messages
  managerPhone String?  // shown on card/contact modal (65j)
  // How volunteers engage with this opportunity (65j):
  //   shifts        - sign up for scheduled shifts (default)
  //   routes        - driver routes; shifts synced from the Route table
  //   self-reported - no signup; volunteers log hours directly
  //   registration  - community partner registers an event + planned delivery date
  kind                 String  @default("shifts")
  maxConcurrentSignups Int?    // per-volunteer cap on active signups across this type (null = unlimited)
  systemManaged        Boolean @default(false) // e.g. Driver Routes: not deletable, kind locked
  active               Boolean @default(true)
  sortOrder            Int     @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  shifts          VolunteerShift[]
  templates       RecurringShiftTemplate[]
  userPreferences UserOpportunityPreference[]
  hourLogs        VolunteerHourLog[]
  registrations   OpportunityRegistration[]

  @@index([active, sortOrder])
}

// Community-partner registration for kind='registration' opportunities
// (Food Drive Signup, Kit Packing Donations): contact info + planned
// delivery date, tracked in-app with a status the admin advances. (65j)
model OpportunityRegistration {
  id                Int      @id @default(autoincrement())
  userId            Int
  opportunityTypeId Int
  plannedDate       DateTime // planned delivery/drop-off date
  phone             String?
  message           String?
  status            String   @default("pending") // pending | confirmed | completed | cancelled
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunityType OpportunityType @relation(fields: [opportunityTypeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([opportunityTypeId])
  @@index([status])
  @@index([plannedDate])
}

// Recurring schedule that generates VolunteerShift rows
// (e.g. "Distribution: every Tue/Thu 09:00-12:00, 6 volunteers").
model RecurringShiftTemplate {
  id                Int       @id @default(autoincrement())
  opportunityTypeId Int
  frequency         String    @default("weekly") // weekly | biweekly | monthly
  daysOfWeek        String    // JSON array of weekday numbers 0(Sun)-6(Sat), e.g. "[2,4]"
  startTime         String    // "09:00"
  endTime           String    // "12:00"
  location          String    @default("Distribution Center")
  spotsNeeded       Int
  notes             String?
  startDate         DateTime  // first date shifts may be generated for
  endDate           DateTime? // null = open-ended
  generateDaysAhead Int       @default(28) // rolling window for shift generation
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  opportunityType OpportunityType  @relation(fields: [opportunityTypeId], references: [id], onDelete: Cascade)
  shifts          VolunteerShift[]

  @@index([opportunityTypeId])
  @@index([active])
}

// Which opportunity types a volunteer wants shown in their portal.
// Set during onboarding, editable from the profile page.
// Convention: a user with ZERO rows sees ALL active types (opt-out model
// so existing volunteers keep a working portal without setup).
model UserOpportunityPreference {
  id                Int @id @default(autoincrement())
  userId            Int
  opportunityTypeId Int

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunityType OpportunityType @relation(fields: [opportunityTypeId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityTypeId])
  @@index([userId])
}
